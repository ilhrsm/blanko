rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 상품 이미지: products/{sellerId}/{productId}/...
    match /products/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(sellerId);
    }

    // 셀러 쇼핑몰 배경/히어로 이미지: sellers/{sellerId}/...
    match /sellers/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(sellerId);
    }
  }
}
